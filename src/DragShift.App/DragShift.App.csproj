<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF without XAML compilation: the UI is built in code (styles are parsed at runtime with XamlReader), so the app
    builds with the plain .NET SDK on any OS via EnableWindowsTargeting. It still only runs on Windows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DragShift.App</RootNamespace>
    <AssemblyName>DragShift</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dragshift.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>DragShift</Product>
    <Description>Drag a file, hold Shift, drop it on the wheel to convert or edit it.</Description>
    <Copyright>DragShift contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DragShift.Core\DragShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\dragshift.ico" LogicalName="DragShift.icon.ico" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="DragShift.LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="DragShift.THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="..\..\licenses\*.txt" LogicalName="DragShift.licenses.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
